{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Dehradun campus student profile with verified Indian mobile number and saved hostel gate coordinates.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "minLength": 0, "maxLength": 150 },
        "phone": { "type": "string", "pattern": "^\\+91[6-9][0-9]{9}$", "minLength": 13, "maxLength": 13 },
        "phoneVerified": { "type": "boolean" },
        "hostelName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "roomNumber": { "type": "string", "minLength": 1, "maxLength": 30 },
        "emergencyContactName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "gateLat": { "type": "number" },
        "gateLng": { "type": "number" },
        "wellnessPassActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "phone",
        "phoneVerified",
        "hostelName",
        "roomNumber",
        "emergencyContactName",
        "gateLat",
        "gateLng",
        "wellnessPassActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "CampusOrder": {
      "title": "CampusOrder",
      "description": "Emergency late-night OTC relief order with live runner coordinates, handover PIN, and delivery state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 64 },
        "studentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studentName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "studentPhone": { "type": "string", "pattern": "^\\+91[6-9][0-9]{9}$", "minLength": 13, "maxLength": 13 },
        "hostelName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "roomNumber": { "type": "string", "minLength": 1, "maxLength": 30 },
        "gateLat": { "type": "number" },
        "gateLng": { "type": "number" },
        "runnerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "runnerPhone": { "type": "string", "pattern": "^\\+91[6-9][0-9]{9}$", "minLength": 13, "maxLength": 13 },
        "runnerLat": { "type": "number" },
        "runnerLng": { "type": "number" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "wellnessPassAdded": { "type": "boolean" },
        "totalPayable": { "type": "number" },
        "upiProvider": { "type": "string", "enum": ["GPay", "PhonePe", "Paytm"] },
        "handoverPin": { "type": "string", "pattern": "^[0-9]{4}$", "minLength": 4, "maxLength": 4 },
        "trackerStep": { "type": "number", "enum": [1, 2, 3, 4] },
        "status": { "type": "string", "enum": ["queued", "picked_up", "gate_cleared", "arrived", "delivered"] },
        "deliveryMinutes": { "type": "number" },
        "specialInstructions": { "type": "string", "minLength": 0, "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "studentUid",
        "studentName",
        "studentPhone",
        "hostelName",
        "roomNumber",
        "gateLat",
        "gateLng",
        "runnerName",
        "runnerPhone",
        "runnerLat",
        "runnerLng",
        "items",
        "subtotal",
        "deliveryFee",
        "wellnessPassAdded",
        "totalPayable",
        "upiProvider",
        "handoverPin",
        "trackerStep",
        "status",
        "deliveryMinutes",
        "createdAt",
        "updatedAt"
      ]
    },
    "KitItem": {
      "title": "KitItem",
      "description": "OTC relief kit or emergency item managed by campus pharmacy operations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": [
            "Fever & Cold",
            "Headache & Migraine",
            "Stomach & Acidity",
            "First-Aid & Sprains",
            "Hydration & Energy",
            "Period & Cramp Care",
            "Personal Hygiene & Masks",
            "Sleep & Wellness"
          ]
        },
        "price": { "type": "number" },
        "contents": { "type": "array" },
        "reliefFor": { "type": "string", "minLength": 2, "maxLength": 200 },
        "imagePath": { "type": "string", "minLength": 0, "maxLength": 300 },
        "etaMinutes": { "type": "number" },
        "sealedCode": { "type": "string", "minLength": 2, "maxLength": 32 },
        "inStock": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "name",
        "category",
        "price",
        "contents",
        "reliefFor",
        "imagePath",
        "etaMinutes",
        "sealedCode",
        "inStock",
        "updatedAt"
      ]
    },
    "RoleRecord": {
      "title": "RoleRecord",
      "description": "Authorized campus runner or operations admin membership marker.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "assignedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "assignedAt"]
    },
    "OrderFeedback": {
      "title": "OrderFeedback",
      "description": "Post-delivery 1-to-5 star runner rating and optional short comment submitted by the student after delivery completion.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 3, "maxLength": 64 },
        "studentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studentName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "runnerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "hostelName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 0, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderId",
        "studentUid",
        "studentName",
        "runnerName",
        "hostelName",
        "rating",
        "comment",
        "createdAt"
      ]
    },
    "SharedTracker": {
      "title": "SharedTracker",
      "description": "Sanitized, PII-free live delivery status snapshot for roommate deep-link tracking.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 3, "maxLength": 64 },
        "hostelName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "gateLat": { "type": "number" },
        "gateLng": { "type": "number" },
        "runnerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "runnerLat": { "type": "number" },
        "runnerLng": { "type": "number" },
        "itemsSummary": { "type": "array" },
        "trackerStep": { "type": "number", "enum": [1, 2, 3, 4] },
        "status": { "type": "string", "enum": ["queued", "picked_up", "gate_cleared", "arrived", "delivered"] },
        "deliveryMinutes": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderId",
        "hostelName",
        "gateLat",
        "gateLng",
        "runnerName",
        "runnerLat",
        "runnerLng",
        "itemsSummary",
        "trackerStep",
        "status",
        "deliveryMinutes",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Student campus profiles keyed by Firebase Auth UID."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/CampusOrder" },
      "description": "Emergency late-night OTC orders tracked in real time."
    },
    "/kits/{kitId}": {
      "schema": { "$ref": "#/entities/KitItem" },
      "description": "OTC relief kits catalog and real-time stock status."
    },
    "/feedback/{orderId}": {
      "schema": { "$ref": "#/entities/OrderFeedback" },
      "description": "Post-delivery student runner ratings (1-5 stars) and short comments keyed by orderId."
    },
    "/sharedTrackers/{orderId}": {
      "schema": { "$ref": "#/entities/SharedTracker" },
      "description": "Sanitized live delivery tracking snapshots accessible via shareable deep-links."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/RoleRecord" },
      "description": "Authorized campus operations administrators."
    },
    "/runners/{runnerId}": {
      "schema": { "$ref": "#/entities/RoleRecord" },
      "description": "Authorized late-night student runners."
    }
  }
}
