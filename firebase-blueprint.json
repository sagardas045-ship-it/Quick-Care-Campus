{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Dehradun campus student profile with verified Indian mobile number and saved hostel gate coordinates.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "minLength": 3, "maxLength": 150 },
        "phone": { "type": "string", "pattern": "^\\+91[6-9][0-9]{9}$", "minLength": 13, "maxLength": 13 },
        "phoneVerified": { "type": "boolean" },
        "hostelName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "roomNumber": { "type": "string", "minLength": 1, "maxLength": 30 },
        "emergencyContactName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "gateLat": { "type": "number" },
        "gateLng": { "type": "number" },
        "wellnessPassActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "phone",
        "phoneVerified",
        "hostelName",
        "roomNumber",
        "emergencyContactName",
        "gateLat",
        "gateLng",
        "wellnessPassActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "CampusOrder": {
      "title": "CampusOrder",
      "description": "Emergency late-night OTC relief order with live runner coordinates, handover PIN, and delivery state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 64 },
        "studentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studentName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "studentPhone": { "type": "string", "pattern": "^\\+91[6-9][0-9]{9}$", "minLength": 13, "maxLength": 13 },
        "hostelName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "roomNumber": { "type": "string", "minLength": 1, "maxLength": 30 },
        "gateLat": { "type": "number" },
        "gateLng": { "type": "number" },
        "runnerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "runnerPhone": { "type": "string", "pattern": "^\\+91[6-9][0-9]{9}$", "minLength": 13, "maxLength": 13 },
        "runnerLat": { "type": "number" },
        "runnerLng": { "type": "number" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "wellnessPassAdded": { "type": "boolean" },
        "totalPayable": { "type": "number" },
        "upiProvider": { "type": "string", "enum": ["GPay", "PhonePe", "Paytm"] },
        "handoverPin": { "type": "string", "pattern": "^[0-9]{4}$", "minLength": 4, "maxLength": 4 },
        "trackerStep": { "type": "number", "enum": [1, 2, 3, 4] },
        "status": { "type": "string", "enum": ["queued", "picked_up", "gate_cleared", "arrived", "delivered"] },
        "deliveryMinutes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "studentUid",
        "studentName",
        "studentPhone",
        "hostelName",
        "roomNumber",
        "gateLat",
        "gateLng",
        "runnerName",
        "runnerPhone",
        "runnerLat",
        "runnerLng",
        "items",
        "subtotal",
        "deliveryFee",
        "wellnessPassAdded",
        "totalPayable",
        "upiProvider",
        "handoverPin",
        "trackerStep",
        "status",
        "deliveryMinutes",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoleRecord": {
      "title": "RoleRecord",
      "description": "Authorized campus runner or operations admin membership marker.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "assignedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "assignedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Student campus profiles keyed by Firebase Auth UID."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/CampusOrder" },
      "description": "Emergency late-night OTC orders tracked in real time."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/RoleRecord" },
      "description": "Authorized campus operations administrators."
    },
    "/runners/{runnerId}": {
      "schema": { "$ref": "#/entities/RoleRecord" },
      "description": "Authorized late-night student runners."
    }
  }
}
